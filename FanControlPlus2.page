<?php
/* Redirect shim for the pre-2026.08.18b settings route.
 *
 * The page file was renamed to FanControlPlus2.page so the Settings menu would
 * sort it under F (Unraid orders that menu by .page filename, case-sensitively).
 * That changed the route, which left bookmarks - and any browser tab rendered
 * before the update - pointing at a route that no longer existed, showing an
 * empty page with no explanation.
 *
 * Deliberately has NO Menu= key: build_pages() registers every .page in $site
 * and the dispatcher resolves $site[basename($path)], but find_pages() skips
 * anything without a Menu, so this stays routable without appearing in the menu
 * a second time. Unraid ships several pages this way (SMBSharesAdd.page etc).
 */
?>
<script>location.replace('/Settings/FanControlPlus2' + window.location.search);</script>
<noscript>
  <meta http-equiv="refresh" content="0;url=/Settings/FanControlPlus2">
</noscript>
<p style="padding:16px">
  This page has moved to <a href="/Settings/FanControlPlus2">Settings &rarr; FanControl Plus 2</a>.
  Please update your bookmark.
</p>
